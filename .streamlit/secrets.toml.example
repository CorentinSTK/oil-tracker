# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
EIA_API_KEY = "your-eia-key"        # https://www.eia.gov/opendata/register.php
FRED_API_KEY = "your-fred-key"      # https://fred.stlouisfed.org/docs/api/api_key.html
# Optional: without it the public OilPriceAPI demo endpoint is used.
# OILPRICEAPI_KEY = "your-oilpriceapi-key"
